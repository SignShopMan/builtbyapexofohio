---
/** Side-by-side before/after. Upgrade to a slider later if wanted. */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { before: ImageMetadata; after: ImageMetadata; alt: string }
const { before, after, alt } = Astro.props;
const [fullBefore, fullAfter] = await Promise.all(
  [before, after].map((src) => getImage({ src, width: Math.min(1920, src.width), format: 'webp', quality: 82 })),
);
const setId = `ba-${Math.random().toString(36).slice(2, 8)}`;
---
<div class="grid gap-3 sm:grid-cols-2">
  {[{ img: before, full: fullBefore, label: 'Before' }, { img: after, full: fullAfter, label: 'After', gold: true }].map(({ img, full, label, gold }) => (
    <figure class="relative aspect-[4/3] overflow-hidden bg-apex-charcoal">
      <a href={full.src} data-lightbox={setId} data-alt={`${alt} — ${label.toLowerCase()}`} class="block h-full w-full" aria-label={`View larger: ${alt} — ${label.toLowerCase()}`}>
        <Image src={img} alt={`${alt} — ${label.toLowerCase()}`} widths={[480, 768, 1024]} sizes="(min-width: 640px) 50vw, 100vw" loading="lazy" class="h-full w-full object-cover" />
      </a>
      <figcaption class:list={['absolute top-3 left-3 px-3 py-1 font-display font-black uppercase text-sm clip-badge', gold ? 'bg-apex-gold text-apex-black' : 'bg-apex-black text-white']}>
        {label}
      </figcaption>
    </figure>
  ))}
</div>
