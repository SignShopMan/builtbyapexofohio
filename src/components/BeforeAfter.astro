---
/** Side-by-side before/after. Upgrade to a slider later if wanted. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { before: ImageMetadata; after: ImageMetadata; alt: string }
const { before, after, alt } = Astro.props;
---
<div class="grid gap-3 sm:grid-cols-2">
  {[{ img: before, label: 'Before' }, { img: after, label: 'After', gold: true }].map(({ img, label, gold }) => (
    <figure class="relative aspect-[4/3] overflow-hidden bg-apex-charcoal">
      <Image src={img} alt={`${alt} — ${label.toLowerCase()}`} widths={[480, 768, 1024]} sizes="(min-width: 640px) 50vw, 100vw" loading="lazy" class="h-full w-full object-cover" />
      <figcaption class:list={['absolute top-3 left-3 px-3 py-1 font-display font-black uppercase text-sm clip-badge', gold ? 'bg-apex-gold text-apex-black' : 'bg-apex-black text-white']}>
        {label}
      </figcaption>
    </figure>
  ))}
</div>
