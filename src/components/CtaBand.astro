---
/** Financing / free-estimate callout: black plate, big gold number, red CTA (guide §11.1). */
import Button from './Button.astro';
import { site } from '../data/site';
interface Props { variant?: 'financing' | 'estimate' }
const { variant = 'financing' } = Astro.props;
---
<section class="bg-apex-black text-white clip-diag-t">
  <div class="container-apex py-20 md:py-24 grid gap-10 lg:grid-cols-[auto_1fr_auto] items-center">
    {variant === 'financing' ? (
      <p class="font-display font-black leading-none">
        <span class="block text-7xl md:text-8xl lg:text-9xl text-apex-gold">0%</span>
        <span class="eyebrow text-white">Financing Available</span>
      </p>
    ) : (
      <p class="font-display font-black leading-none">
        <span class="block text-5xl md:text-6xl lg:text-7xl text-apex-gold">FREE</span>
        <span class="eyebrow text-white">Estimates</span>
      </p>
    )}
    <div class="max-w-xl">
      <h2 class="h2 text-white">Your next project may be more affordable than you think.</h2>
      <p class="mt-4 text-apex-chrome text-lg leading-relaxed">
        {variant === 'financing'
          ? 'Get the project you want today with affordable monthly payments. 0% financing for qualified customers on roofing, siding, gutters, pole barns, and more.'
          : 'Call, text, or send a message and we’ll come take a look. No pressure, no obligation — just a straight answer and a fair price.'}
      </p>
    </div>
    <div class="flex flex-col gap-3 lg:items-end">
      <Button href="/contact" size="lg">Get a Free Estimate</Button>
      <Button href={site.phoneHref} variant="secondary" size="lg">Call or Text {site.phone}</Button>
    </div>
  </div>
</section>
