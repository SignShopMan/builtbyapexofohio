---
/**
 * Hearth-style monthly payment estimator. Pure client-side math; rates and
 * terms come from src/data/financing.ts and are serialized into the markup.
 */
import { tiers, terms, promo, defaults, monthlyPayment } from '../data/financing';
import { site } from '../data/site';
import Icon from './Icon.astro';

const applyHref = site.hearthUrl || '/contact';
const applyExternal = Boolean(site.hearthUrl);
const initial = tiers.find((t) => t.id === defaults.tier)!;
const fmt = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
const termLabel = (m: number) => (m % 12 === 0 ? `${m / 12} years` : `${m} months`);
---
<div
  id="payment-calc"
  class="bg-apex-black text-white p-6 md:p-8 clip-corner"
  data-tiers={JSON.stringify(tiers)}
  data-terms={JSON.stringify(terms)}
  data-promo={JSON.stringify(promo)}
>
  <p class="eyebrow text-apex-gold">Monthly payment calculator</p>
  <h2 class="font-display font-black text-2xl md:text-3xl mt-1">What would it run per month?</h2>

  <!-- Credit tier -->
  <div class="mt-6 flex items-baseline justify-between">
    <label class="eyebrow text-xs text-apex-chrome" id="tier-label">Credit score range</label>
    <span class="text-sm text-apex-chrome" data-range>{initial.range}</span>
  </div>
  <div class="mt-2 grid grid-cols-4 gap-1 bg-apex-charcoal p-1 rounded-apex" role="radiogroup" aria-labelledby="tier-label">
    {tiers.map((t) => (
      <button
        type="button"
        role="radio"
        aria-checked={t.id === defaults.tier ? 'true' : 'false'}
        data-tier={t.id}
        class="py-2.5 text-sm font-display font-bold rounded-apex transition-colors aria-checked:bg-apex-red aria-checked:text-white text-apex-chrome hover:text-white"
      >
        {t.label}
      </button>
    ))}
  </div>

  <!-- Cost -->
  <label class="block mt-6">
    <span class="eyebrow text-xs text-apex-chrome">Project cost</span>
    <span class="mt-2 flex items-center bg-apex-charcoal rounded-apex border-2 border-transparent focus-within:border-apex-gold">
      <span class="pl-4 pr-2 font-display font-bold text-apex-chrome" aria-hidden="true">$</span>
      <input
        type="text"
        inputmode="numeric"
        data-cost
        value={defaults.cost.toLocaleString('en-US')}
        min={defaults.min}
        max={defaults.max}
        class="w-full bg-transparent py-3.5 pr-4 font-display font-black text-2xl text-white outline-none"
        aria-label="Project cost in dollars"
      />
    </span>
  </label>
  <input type="range" data-slider min={defaults.min} max={defaults.max} step="500" value={defaults.cost} class="mt-3 w-full accent-apex-red" aria-label="Project cost slider" />

  <!-- Results -->
  <p class="eyebrow text-xs text-apex-chrome mt-6">Estimated payments*</p>
  <ul class="mt-2 divide-y divide-apex-chrome-shadow/40 border-y border-apex-chrome-shadow/40" data-results>
    {promo.enabled && (
      <li class="flex items-center justify-between gap-4 py-3.5" data-row="promo">
        <span>
          <span class="font-display font-black text-2xl text-apex-gold" data-pay>{fmt(monthlyPayment(defaults.cost, 0, promo.months))}</span>
          <span class="text-apex-chrome text-sm"> / mo</span>
        </span>
        <span class="text-right text-sm text-apex-chrome">
          <span class="block">{promo.months} months</span>
          <span class="block text-apex-gold font-bold">{promo.label}†</span>
        </span>
      </li>
    )}
    {terms.map((m) => (
      <li class="flex items-center justify-between gap-4 py-3.5" data-row={m}>
        <span>
          <span class="font-display font-black text-2xl" data-pay>{fmt(monthlyPayment(defaults.cost, initial.apr[m], m))}</span>
          <span class="text-apex-chrome text-sm"> / mo</span>
        </span>
        <span class="text-right text-sm text-apex-chrome">
          <span class="block">{termLabel(m)}</span>
          <span class="block" data-apr>{initial.apr[m].toFixed(2)}% APR</span>
        </span>
      </li>
    ))}
  </ul>

  <div class="mt-6 flex flex-col sm:flex-row gap-3">
    <a
      href={applyHref}
      target={applyExternal ? '_blank' : undefined}
      rel={applyExternal ? 'noopener' : undefined}
      class="inline-flex items-center justify-center gap-2 bg-apex-red hover:bg-apex-red-deep text-white font-display font-bold uppercase tracking-button text-sm px-6 py-4 rounded-apex transition-colors"
    >
      {applyExternal ? 'See my real options' : 'Ask about financing'}
      <Icon name="chevron" class="w-4 h-4" />
    </a>
    <a href={site.phoneHref} class="inline-flex items-center justify-center border-2 border-apex-gold text-apex-gold hover:bg-apex-gold hover:text-apex-black font-display font-bold uppercase tracking-button text-sm px-6 py-4 rounded-apex transition-colors">
      Call {site.phone}
    </a>
  </div>
  {applyExternal && (
    <p class="mt-3 text-xs text-apex-chrome">Checking your options through Hearth takes about two minutes and uses a soft credit inquiry that does not affect your credit score. See Hearth's terms.</p>
  )}

  <!-- Fine print -->
  <div class="mt-6 space-y-2 text-[11px] leading-relaxed text-apex-chrome-shadow">
    <p>
      * <strong class="text-apex-chrome">Estimates only.</strong> Payments shown are illustrative examples based on the credit range and project cost you selected, calculated as a fixed-rate, fully amortized loan. They are not a quote, a rate lock, a pre-qualification, or an offer or commitment to lend. Your actual rate, term, payment, fees, and approval are determined solely by the lender after you apply, based on your full credit profile and other factors. Actual APRs vary widely by lender and applicant and may be higher or lower than shown. Not all applicants will qualify. Not all terms shown will be available to every applicant.
    </p>
    {promo.enabled && (
      <p>
        † <strong class="text-apex-chrome">Promotional financing</strong> such as 0% APR is offered by participating lenders only for qualified applicants, for limited terms, and may be subject to deferred-interest provisions, minimum purchase amounts, and other conditions. If a deferred-interest plan is not paid in full by the end of the promotional period, interest may be charged from the original purchase date. Ask us for current promotional offers and read the lender's disclosures carefully before accepting any plan.
      </p>
    )}
    <p>
      {site.legalName} is a home-improvement contractor, not a lender or broker. We do not accept credit applications, make loans, or make credit decisions. Financing is made available through Hearth, a technology company licensed as a broker where required by state law, and its network of lending partners. Hearth does not accept applications for credit, does not make loans, and does not make credit decisions. All APRs, introductory rates, terms, amounts, and fees are provided by Hearth's lending partners and are subject to credit approval. This calculator does not constitute an offer or solicitation to lend. Financing availability, lenders, and terms are subject to change without notice.
    </p>
  </div>
</div>

<script>
  import { monthlyPayment } from '../data/financing';

  const root = document.getElementById('payment-calc');
  if (root) {
    type Tier = { id: string; label: string; range: string; apr: Record<string, number> };
    const tiers: Tier[] = JSON.parse(root.dataset.tiers!);
    const terms: number[] = JSON.parse(root.dataset.terms!);
    const promo: { enabled: boolean; months: number } = JSON.parse(root.dataset.promo!);

    const costInput = root.querySelector<HTMLInputElement>('[data-cost]')!;
    const slider = root.querySelector<HTMLInputElement>('[data-slider]')!;
    const rangeEl = root.querySelector<HTMLElement>('[data-range]')!;
    const tierBtns = root.querySelectorAll<HTMLButtonElement>('[data-tier]');
    const min = Number(costInput.min), max = Number(costInput.max);
    const fmt = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });

    let tier = tiers.find((t) => t.id === root.querySelector('[aria-checked="true"]')?.getAttribute('data-tier')) ?? tiers[0];
    let cost = Number(costInput.value.replace(/[^\d]/g, '')) || 0;

    const render = () => {
      rangeEl.textContent = tier.range;
      if (promo.enabled) {
        root.querySelector('[data-row="promo"] [data-pay]')!.textContent = fmt(monthlyPayment(cost, 0, promo.months));
      }
      for (const m of terms) {
        const row = root.querySelector(`[data-row="${m}"]`)!;
        const apr = tier.apr[String(m)];
        row.querySelector('[data-pay]')!.textContent = fmt(monthlyPayment(cost, apr, m));
        row.querySelector('[data-apr]')!.textContent = `${apr.toFixed(2)}% APR`;
      }
    };

    const setCost = (n: number, fromSlider = false) => {
      cost = Math.min(max, Math.max(min, Math.round(n)));
      if (!fromSlider) slider.value = String(cost);
      render();
    };

    tierBtns.forEach((b) =>
      b.addEventListener('click', () => {
        tierBtns.forEach((x) => x.setAttribute('aria-checked', 'false'));
        b.setAttribute('aria-checked', 'true');
        tier = tiers.find((t) => t.id === b.dataset.tier)!;
        render();
      }),
    );
    costInput.addEventListener('input', () => {
      const n = Number(costInput.value.replace(/[^\d]/g, '')) || 0;
      cost = n; slider.value = String(Math.min(max, Math.max(min, n)));
      render();
    });
    costInput.addEventListener('blur', () => {
      setCost(cost);
      costInput.value = cost.toLocaleString('en-US');
    });
    slider.addEventListener('input', () => {
      setCost(Number(slider.value), true);
      costInput.value = cost.toLocaleString('en-US');
    });
  }
</script>
