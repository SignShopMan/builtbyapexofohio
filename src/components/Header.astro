---
import { site } from '../data/site';
import { services } from '../data/services';
import Icon from './Icon.astro';
import Stripe from './Stripe.astro';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));

// Nav children: the Services item gets one entry per service page
const children = (href: string) =>
  href === '/services' ? services.map((s) => ({ label: s.name, href: `/services/${s.slug}` })) : [];
---

<header class="sticky top-0 z-50 bg-apex-black">
  <div class="container-apex flex items-center justify-between gap-6 py-3">
    <a href="/" class="shrink-0" aria-label={`${site.name} home`}>
      <img
        src="/brand/apex-wordmark-lockup-outline.svg"
        alt={site.name}
        width="220"
        height="77"
        class="h-12 w-auto md:h-14"
        fetchpriority="high"
      />
    </a>

    <nav class="hidden lg:block" aria-label="Primary">
      <ul class="flex items-center gap-5 xl:gap-7">
        {site.nav.map(({ label, href }) => {
          const kids = children(href);
          const linkClass = [
            'font-display font-semibold text-[13px] xl:text-sm uppercase tracking-wide whitespace-nowrap transition-colors hover:text-apex-gold',
            isActive(href) ? 'text-apex-gold' : 'text-white',
          ];
          return kids.length === 0 ? (
            <li>
              <a href={href} class:list={linkClass} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
            </li>
          ) : (
            <li class="relative group">
              <a
                href={href}
                class:list={[...linkClass, 'inline-flex items-center gap-1 py-2']}
                aria-current={isActive(href) ? 'page' : undefined}
                aria-haspopup="true"
              >
                {label}
                <Icon name="chevron" class="w-3 h-3 rotate-90 transition-transform group-hover:-rotate-90 group-focus-within:-rotate-90" />
              </a>
              <ul
                class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-opacity absolute left-0 top-full z-50 min-w-64 bg-apex-charcoal border-t-4 border-apex-red shadow-2xl shadow-black/60 py-2"
              >
                {kids.map((k) => (
                  <li>
                    <a
                      href={k.href}
                      class:list={[
                        'block px-5 py-2.5 font-display font-semibold text-sm hover:bg-apex-black hover:text-apex-gold transition-colors',
                        isActive(k.href) ? 'text-apex-gold' : 'text-white',
                      ]}
                      aria-current={isActive(k.href) ? 'page' : undefined}
                    >
                      {k.label}
                    </a>
                  </li>
                ))}
                <li class="mt-1 border-t border-apex-chrome-shadow/40">
                  <a href={href} class="block px-5 py-2.5 eyebrow text-xs text-apex-gold hover:text-white transition-colors">All services »</a>
                </li>
              </ul>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="hidden md:max-lg:flex xl:flex flex-col items-end leading-none">
      <span class="eyebrow text-apex-red text-[11px]">Call or Text</span>
      <a
        href={site.phoneHref}
        class="font-display font-black text-xl xl:text-2xl tracking-tight whitespace-nowrap text-white hover:text-apex-gold transition-colors"
      >
        {site.phone}
      </a>
    </div>
    <a
      href={site.phoneHref}
      class="hidden lg:max-xl:inline-flex items-center justify-center h-11 w-11 bg-apex-red text-white rounded-apex shrink-0"
      aria-label={`Call ${site.phone}`}
    >
      <Icon name="phone" class="w-5 h-5" />
    </a>

    <div class="flex items-center gap-3 lg:hidden">
      <a
        href={site.phoneHref}
        class="md:hidden inline-flex items-center justify-center h-11 w-11 bg-apex-red text-white rounded-apex"
        aria-label={`Call ${site.phone}`}
      >
        <Icon name="phone" class="w-5 h-5" />
      </a>
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex items-center justify-center h-11 w-11 text-white border-2 border-apex-chrome-shadow rounded-apex"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <Icon name="menu" class="w-6 h-6" />
      </button>
    </div>
  </div>

  <Stripe />

  <nav id="mobile-nav" class="hidden lg:hidden bg-apex-charcoal border-t border-apex-chrome-shadow/40" aria-label="Mobile">
    <ul class="container-apex py-2 divide-y divide-apex-chrome-shadow/30">
      {site.nav.map(({ label, href }) => {
        const kids = children(href);
        return (
          <li>
            <a
              href={href}
              class:list={[
                'block py-3.5 font-display font-bold uppercase tracking-wide',
                isActive(href) ? 'text-apex-gold' : 'text-white',
              ]}
            >
              {label}
            </a>
            {kids.length > 0 && (
              <ul class="pb-3 pl-4 border-l-2 border-apex-red ml-1">
                {kids.map((k) => (
                  <li>
                    <a
                      href={k.href}
                      class:list={[
                        'block py-2 font-display font-semibold text-sm',
                        isActive(k.href) ? 'text-apex-gold' : 'text-apex-chrome',
                      ]}
                    >
                      {k.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        );
      })}
      <li>
        <a href={site.phoneHref} class="block py-3.5 font-display font-black text-xl text-apex-gold">
          {site.phone}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
