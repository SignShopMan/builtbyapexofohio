---
/**
 * Brand buttons (guide §11.3).
 * primary   — red fill, white text. The action color.
 * secondary — gold outline, for dark backgrounds only.
 * ghost     — white outline, for photo overlays.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  class?: string;
}
const { href, variant = 'primary', size = 'md', class: cls = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 font-display font-bold uppercase tracking-button rounded-apex transition-colors';
const sizes = { md: 'text-sm px-6 py-3.5', lg: 'text-base px-8 py-4' };
const variants = {
  primary: 'bg-apex-red text-white hover:bg-apex-red-deep',
  secondary: 'border-2 border-apex-gold text-apex-gold hover:bg-apex-gold hover:text-apex-black',
  ghost: 'border-2 border-white text-white hover:bg-white hover:text-apex-black',
};
---
<a href={href} class:list={[base, sizes[size], variants[variant], cls]}>
  <slot />
</a>
